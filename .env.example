# Copy this file to .env.local. The local file is ignored by Git.
ASIDE_PROVIDER=openai
ASIDE_MODEL=gpt-4o-mini

# Optional HTTP(S) endpoint override for the selected Pi provider model.
# Use this for an OpenAI-compatible gateway or local server.
# ASIDE_API_URL=https://api.openai.com/v1

# Set only the credential for the selected provider.
OPENAI_API_KEY=replace-with-your-key
# ANTHROPIC_API_KEY=replace-with-your-key
# DEEPSEEK_API_KEY=replace-with-your-key
# GEMINI_API_KEY=replace-with-your-key
