{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aside",
  "version": "0.1.0",
  "identifier": "com.aside.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aside",
        "width": 420,
        "height": 760,
        "minWidth": 1,
        "minHeight": 1,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": true,
        "focus": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "backgroundColor": "#00000000",
        "theme": "Light",
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
