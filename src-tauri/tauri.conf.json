{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aside",
  "version": "0.1.0",
  "identifier": "com.aside.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aside",
        "width": 420,
        "height": 680,
        "minWidth": 340,
        "minHeight": 460,
        "maxWidth": 520,
        "maxHeight": 900,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["acrylic"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
