{
  "name": "@earendil-works/pi-agent-core",
  "version": "0.84.4",
  "description": "Vendored Pi agent kernel and session layer used by Aside",
  "license": "MIT",
  "type": "module",
  "main": "./build/aside.js",
  "types": "./build/aside.d.ts",
  "exports": {
    ".": {
      "types": "./build/aside.d.ts",
      "import": "./build/aside.js"
    },
    "./aside": {
      "types": "./build/aside.d.ts",
      "import": "./build/aside.js"
    },
    "./session": {
      "types": "./build/harness/session/session.d.ts",
      "import": "./build/harness/session/session.js"
    }
  },
  "files": ["build", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-telemetry": "0.84.4",
    "diff": "8.0.4",
    "ignore": "7.0.5",
    "typebox": "1.3.7",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
