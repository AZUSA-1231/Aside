# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Provider credentials. The runtime reads `.env.local`; `.env` is ignored too so
# a mistyped filename cannot put a live key into a commit.
.env
.env.*
!.env.example

# Local MCP server definitions. No secrets by design — a server configuration
# references credentials by name rather than holding them — but it is per-machine
# setup that names local paths, so it is not repository content.
mcp.json
vendor/pi-full/

# Staged by `node scripts/stage-runtime.mjs` before `tauri build`. Build output,
# not source: it is ~80 MB of copied dependencies and a downloaded Node binary,
# and Tauri resolves these paths at build time, so committing them would break
# the build for anyone who has not run the script.
src-tauri/resources/

# Reference-only vendor trees: reviewed for design, not built or shipped.
# `vendor/pi` is a real runtime dependency and stays tracked.
vendor/Office-Word-MCP-Server/
vendor/docx-mcp/

# DeepSeek Harness reference snapshot. Read-only design reference for the
# provider seam, tool/skill declaration split, ask-user/approval separation and
# compaction structure (see docs/RELEASE-CAPABILITIES.md §6). It is a large
# third-party tree that is neither built nor shipped, so its absence from a
# commit must not depend on remembering not to `git add -A` it.
vendor/deepseek-harness/

# Read for adversarial MCP fixture shapes (Cycle 6 P6). A fixture source, never
# a runtime dependency: not bundled, not default-configured, not built.
vendor/web-search-mcp/

# Alternate build output used when `dist/` or the Cargo target directory is
# locked by another process. Build artifacts, not source.
.cache/
.cargo-review/
.build-review/

# The WinIsland prototype is a separate git repository used as a design and
# interaction reference. Only the pieces copied into docs/ are tracked here;
# the tree itself is not part of this product. See docs/design/README.md.
WinIsland/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
